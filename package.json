{
  "name": "parcel-manage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "seed": "node --env-file=.env.local scripts/seed.mts",
    "db:types": "sh scripts/db-types.sh",
    "import:appfolio": "node --env-file=.env.local scripts/import-appfolio.mts",
    "auth:emails": "node scripts/auth-emails.mts",
    "import:tenants": "node --env-file=.env.local scripts/import-tenant-directory.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
