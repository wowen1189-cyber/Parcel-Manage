# Copy to .env.local and fill in. Never commit real values.

# Resend: transactional email and inbound invoices / call summaries
RESEND_API_KEY=
RESEND_FROM_DOMAIN=parceltm.com
# Invoices e-mailed to bills-<company subdomain>@ this domain become bills (receiving must be on in Resend)
RESEND_INBOUND_DOMAIN=
# Resend webhook (email.received → /api/email/inbound): its signing secret, whsec_...
RESEND_WEBHOOK_SECRET=

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Root domain for company subdomains (SIM REI: simreipm.<root>). Production (Vercel) uses parcelmanage.com; locally use localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Scheduled jobs (vercel.json crons): Vercel sends this as a Bearer token. Any long random string.
CRON_SECRET=

# Twilio (Parcel Manage platform account): console.twilio.com → Account info. Each company sets its number in Settings › Texting
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Stripe Connect (Parcel Manage platform account): dashboard.stripe.com → Developers → API keys / Webhooks (Connect events)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (pk_...): public, used by the bank-feed connect window (Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Checkr Tenant screening (tenant.checkr.com > Developer settings). Use a TEST key (ckr_sk_test_…) until going live:
# live keys (ckr_sk_live_…) place real, billed screenings. Never paste keys in chat or code.
CHECKR_TENANT_API_KEY=
# Signing secret of the webhook endpoint https://<your domain>/api/checkr/webhook (shown once when created).
CHECKR_WEBHOOK_SECRET=
