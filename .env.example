# Copy to .env.local and fill in. Never commit real values.

# Resend: transactional email and inbound invoices / call summaries
RESEND_API_KEY=
RESEND_FROM_DOMAIN=parceltm.com
RESEND_INBOUND_DOMAIN=parceltm.com

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Root domain for company subdomains (SIM REI: simreipm.<root>). Production (Vercel) uses parcelmanage.com; locally use localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Scheduled jobs (vercel.json crons): Vercel sends this as a Bearer token. Any long random string.
CRON_SECRET=

# Stripe Connect (Parcel Manage platform account): dashboard.stripe.com → Developers → API keys / Webhooks (Connect events)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
